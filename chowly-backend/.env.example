DATABASE_URL=
# Example Neon connection string:
# postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/chowly?sslmode=require

JWT_SECRET_KEY=

# Comma-separated list of origins the frontend may be served from.
# In dev the Next.js app runs on either http://localhost:3000 or
# http://127.0.0.1:3000 depending on which form the user types in
# the browser; in production set this to the deployed Vercel domain
# (e.g. https://chowly.vercel.app). If unset, the backend falls back
# to both localhost:3000 and 127.0.0.1:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
